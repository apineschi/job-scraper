name: Test Email Output

on:
  workflow_dispatch: # This adds the "Run workflow" button

jobs:
  test_send:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: |
          pip install playwright beautifulsoup4
          playwright install chromium

      - name: Run Scraper
        run: |
          # We run the script and capture EVERYTHING it prints
          python jobscraper.py > test_results.txt
          
          # Load the results into the environment
          echo "TEST_BODY<<EOF" >> $GITHUB_ENV
          cat test_results.txt >> $GITHUB_ENV
          echo "EOF" >> $GITHUB_ENV

      - name: Send Test Email
        uses: dawidd6/action-send-mail@v3
        with:
          server_address: smtp.gmail.com
          server_port: 465
          username: ${{ secrets.EMAIL_USERNAME }}
          password: ${{ secrets.EMAIL_PASSWORD }}
          subject: "Bot Test: Here is your current formatting"
          to: ${{ secrets.EMAIL_TO }}
          from: "Museum Bot Test"
          body: |
            Hello Anastasia, 
            
            Here is how your current script output looks:
            
            ---
            ${{ env.TEST_BODY }}
            ---
            
            End of test.
